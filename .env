# ─── Banco de dados ────────────────────────────────────────────────────────
# Dentro do Docker Compose use o hostname do serviço (db), não localhost.
# Para rodar fora do Docker (dev local / testes unitários) use localhost:5432.
DATABASE_URL=postgresql+asyncpg://ridefleet:ridefleet123@db:5432/ridefleet

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Identidade do serviço ─────────────────────────────────────────────────
SERVICE_NAME=ridefleet-grupo-a

# O Core chama de volta o RideFleet via host.docker.internal:8000
# (Nginx do RideFleet exposto na porta 8000 do host)
SERVICE_URL=http://host.docker.internal:8000

# ─── Core ──────────────────────────────────────────────────────────────────
# Dentro da rede Docker ridefleet-net o Core é acessível pelo hostname "core"
CORE_URL=http://core:8080/api/v1

# Preenchido automaticamente pelo register_group() no startup.
# Pode deixar vazio aqui — o app sobrescreve em runtime.
CORE_API_KEY=

# ─── Política de overflow ──────────────────────────────────────────────────
MIN_AVAILABLE_DRIVERS=1
QUEUE_OVERFLOW_THRESHOLD=10

# ─── Leilão ────────────────────────────────────────────────────────────────
MIN_ETA_SECONDS=120
BASE_PRICE=12.0
CORE_TIMEOUT=10
