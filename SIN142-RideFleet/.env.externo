# ============================================================
#  CENARIO: CORE EXTERNO (outra maquina na LAN)
#  Subir com:  docker compose --env-file .env.externo up -d --build
#  ANTES (1x): docker network create ridefleet-net
# ============================================================

# Troque pelos IPs reais:
#   CORE_URL    -> IP do Core (outra maquina)
#   SERVICE_URL -> IP DESTA maquina na LAN (o Core te chama de volta aqui)
CORE_URL=http://192.168.3.58:8080/api/v1
SERVICE_URL=http://192.168.3.15:8000
# Preencha se o Core externo te entregar uma chave fixa; senao deixe vazio.
CORE_API_KEY=

# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ridefleet

# Redis
REDIS_URL=redis://redis:6379

# Identidade do servico (groupId registrado no Core)
SERVICE_NAME=ridefleet-grupo-a

# Politica de overflow
MIN_AVAILABLE_DRIVERS=1
QUEUE_OVERFLOW_THRESHOLD=10

# Leilao
MIN_ETA_SECONDS=120
BASE_PRICE=12.0
CORE_TIMEOUT=10
