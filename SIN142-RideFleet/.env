# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ridefleet

# Redis
REDIS_URL=redis://redis:6379

# Identidade do serviço
SERVICE_NAME=ridefleet
SERVICE_URL=http://host.docker.internal:8000

# Core — preenchido automaticamente após register_group()
CORE_URL=http://host.docker.internal:8080/api/v1
CORE_API_KEY=rfk_4096c4a9e294d33a8b3960eef352798f

# Política de overflow
MIN_AVAILABLE_DRIVERS=1
QUEUE_OVERFLOW_THRESHOLD=10

# Leilão
MIN_ETA_SECONDS=120
BASE_PRICE=12.0
CORE_TIMEOUT=10
