# ============================================================
#  CENARIO: CORE LOCAL (mesma maquina, container na ridefleet-net)
#  Subir com:  docker compose --env-file .env.local up -d --build
# ============================================================

# host.docker.internal alcanca o host a partir de qualquer container.
CORE_URL=http://host.docker.internal:8080/api/v1
SERVICE_URL=http://host.docker.internal:8000
# Vazio: registra e obtem uma chave nova do Core local (banco zerado).
CORE_API_KEY=rfk_90e901865a645dd13a6757ac5ec77491

# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ridefleet

# Redis
REDIS_URL=redis://redis:6379

# Identidade do servico (groupId registrado no Core)
SERVICE_NAME=group-01

# Politica de overflow
MIN_AVAILABLE_DRIVERS=1
QUEUE_OVERFLOW_THRESHOLD=10

# Leilao
MIN_ETA_SECONDS=120
BASE_PRICE=12.0
CORE_TIMEOUT=10

# Velocidade da saga: espera entre confirm→in_transit→complete (antes 1s fixo)
SAGA_STEP_DELAY=0.1
# Folga da fila: quantas corridas aceitar ALÉM do nº de motoristas
CAPACITY_SLACK=60
